# Copy to terraform.tfvars and override only what you need.
# terraform.tfvars is gitignored.
#
# All variables have suitable defaults in variables.tf for the standard
# sabeti-adapt deployment — the file can be empty. Override as needed:
#
# project_id              = "sabeti-adapt"
# region                  = "us-central1"
# image                   = "us-docker.pkg.dev/cloudrun/container/hello"  # bootstrap only; CI deploys the real image
# cloud_run_min_instances = 0
# cloud_run_max_instances = 5
# cloud_run_cpu           = "4"
# cloud_run_memory        = "4Gi"
# cloud_run_concurrency   = 8
# cloud_run_timeout_seconds = 600
# custom_domain             = "primercast.sabeti.broadinstitute.org"  # set to "" to skip
# monitor_email_sender    = "primercast.monitor@gmail.com"   # verified Brevo sender
# monitor_smtp_user       = "1a2b3c001@smtp-brevo.com"       # Brevo SMTP login
# monitor_email_enabled   = true   # only after adding a version to the SMTP-key secret
